Overview

AI systems generally require large amounts of data. However, organizations must comply with the minimization principle under the data protection law if using personal data. This means ensuring that any personal data is adequate, relevant and limited to what is necessary for the purposes for which it is processed.";}s:8:"relation";a:2:{s:10:"references";a:1:{s:29:"sidebar:categories:compliance";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1744172875;}s:7:"creator";s:11:"Aditya Seth";s:4:"user";s:5:"admin";s:11:"last_change";a:9:{s:4:"date";i:1744172875;s:2:"ip";s:14:"73.235.164.232";s:4:"type";s:1:"C";s:2:"id";s:21:"glossary:minimization";s:4:"user";s:5:"admin";s:3:"sum";s:7:"created";s:5:"extra";s:0:"";s:10:"sizechange";i:447;s:4:"mode";s:4:"page";}}}