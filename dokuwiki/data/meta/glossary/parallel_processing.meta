Definition

A method in computing of running two or more processors, or CPUs, to handle separate parts of an overall task. Breaking up different parts of a task among multiple processors helps reduce the amount of time it takes to run a program. Any system that has more than one CPU can perform parallel processing, as well as multicore processors, which are commonly found on computers today.";}s:8:"relation";a:2:{s:10:"references";a:3:{s:12:"glossary:cpu";b:0;s:12:"glossary:gpu";b:0;s:27:"sidebar:categories:software";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:11:"contributor";a:1:{s:5:"admin";s:11:"Aditya Seth";}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1744169925;s:8:"modified";i:1744230771;}s:7:"creator";s:11:"Aditya Seth";s:4:"user";s:5:"admin";s:11:"last_change";a:9:{s:4:"date";i:1744230771;s:2:"ip";s:14:"73.235.164.232";s:4:"type";s:1:"E";s:2:"id";s:28:"glossary:parallel_processing";s:4:"user";s:5:"admin";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:-4;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:5:"admin";s:11:"Aditya Seth";}}}